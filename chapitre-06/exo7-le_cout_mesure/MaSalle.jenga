#!/usr/bin/env python3
# -*- coding: utf-8 -*-

# MaSalle – Jenga Workspace
# Configuration de la salle pour la mesure des deux constructions.

from Jenga import *

with workspace("salle"):
    useconfig("./KitNkentseu/KitNkentseu.jenga")
    configurations(['Debug', 'Release'])
    targetoses([TargetOS.WINDOWS, TargetOS.LINUX, TargetOS.MACOS])
    targetarchs([TargetArch.X86_64])

    with project("MaSalle"):
        consoleapp()
        language("C++")
        location("MaSalle")
        files(["src/**.cpp", "include/**.hpp"])
        usekitnkentseu()
        with filter("config:Release"):
            optimize("Speed")
